---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Tag from "../../components/ui/Tag.astro";
import { formatDate } from "../../lib/utils";

const notes = (await getCollection("notes", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<BaseLayout title="Notes" description="Writing on whatever I'm into at the time.">
  <section class="py-12 sm:py-16">
    <h1 class="text-2xl font-bold">Notes</h1>
    <ul class="mt-10 flex flex-col divide-y divide-ink/15 border-t border-b border-ink/15">
      {
        notes.map((note) => (
          <li class="py-6">
            <a href={`/notes/${note.id}`} class="group block">
              <div class="flex flex-wrap items-baseline justify-between gap-2">
                <h2 class="text-lg font-semibold group-hover:text-red">{note.data.title}</h2>
                <span class="font-mono text-xs text-ink/50">{formatDate(note.data.date)}</span>
              </div>
              <p class="mt-1 text-sm text-ink/70">{note.data.description}</p>
              {note.data.tags.length > 0 && (
                <div class="mt-3 flex flex-wrap gap-2">
                  {note.data.tags.map((tag) => <Tag>{tag}</Tag>)}
                </div>
              )}
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
