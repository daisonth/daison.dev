---
import BaseLayout from "../layouts/BaseLayout.astro";

// Add more channels (GitHub, X, etc.) here as plain entries once decided.
const channels = [{ label: "email", value: "hello@daison.dev", href: "mailto:hello@daison.dev" }];
---

<BaseLayout title="Contact" description="Ways to reach me.">
  <section class="py-12 sm:py-16">
    <h1 class="text-2xl font-bold">Contact</h1>
    <ul class="mt-10 flex flex-col divide-y divide-ink/15 border-t border-b border-ink/15">
      {
        channels.map((channel) => (
          <li class="flex items-center justify-between py-4">
            <span class="text-sm text-ink/50">{channel.label}</span>
            <a href={channel.href} class="font-semibold hover:text-red">
              {channel.value}
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
