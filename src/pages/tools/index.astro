---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ToolTile from "../../components/ui/ToolTile.astro";
---

<BaseLayout
  title="Tools"
  description="A small, growing library of free, ad-free, no-nonsense tools."
>
  <section class="py-12 sm:py-16">
    <h1 class="text-2xl font-bold">Tools</h1>
    <p class="mt-4 max-w-md text-ink/70">
      Free, ad-free, no tracking. Each one is its own small, fast thing — built here because I
      needed it myself. Tap one to open it.
    </p>

    <div class="mt-10 grid grid-cols-3 gap-x-4 gap-y-8 sm:grid-cols-4 sm:gap-x-6">
      <ToolTile name="Calculator" href="/tools/calculator">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <rect x="5" y="2" width="14" height="20"></rect>
          <rect x="7.5" y="4.5" width="9" height="4"></rect>
          <circle cx="8.25" cy="12.5" r="0.75" fill="currentColor" stroke="none"></circle>
          <circle cx="12" cy="12.5" r="0.75" fill="currentColor" stroke="none"></circle>
          <circle cx="15.75" cy="12.5" r="0.75" fill="currentColor" stroke="none"></circle>
          <circle cx="8.25" cy="16" r="0.75" fill="currentColor" stroke="none"></circle>
          <circle cx="12" cy="16" r="0.75" fill="currentColor" stroke="none"></circle>
          <circle cx="15.75" cy="16" r="0.75" fill="currentColor" stroke="none"></circle>
          <circle cx="8.25" cy="19.5" r="0.75" fill="currentColor" stroke="none"></circle>
          <circle cx="12" cy="19.5" r="0.75" fill="currentColor" stroke="none"></circle>
          <circle cx="15.75" cy="19.5" r="0.75" fill="currentColor" stroke="none"></circle>
        </svg>
      </ToolTile>

      <ToolTile name="Shopping list" href="/tools/shopping-list">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <rect x="5" y="3" width="14" height="18"></rect>
          <path d="M9 2h6v3H9z"></path>
          <path d="M8 10.5l1.5 1.5L12 9.5"></path>
          <path d="M14 10.5h3.5"></path>
          <path d="M8 15.5l1.5 1.5L12 14.5"></path>
          <path d="M14 15.5h3.5"></path>
        </svg>
      </ToolTile>

      <ToolTile name="JSON formatter" href="/tools/json-formatter">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M9 3c-1.5 0-2 .7-2 2v3c0 1-.5 2-2 2 1.5 0 2 1 2 2v3c0 1.3.5 2 2 2"></path>
          <path d="M15 3c1.5 0 2 .7 2 2v3c0 1 .5 2 2 2-1.5 0-2 1-2 2v3c0 1.3-.5 2-2 2"></path>
        </svg>
      </ToolTile>

      <ToolTile name="XML formatter" href="/tools/xml-formatter">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M8 7l-4 5 4 5"></path>
          <path d="M16 7l4 5-4 5"></path>
          <path d="M13 5l-2 14"></path>
        </svg>
      </ToolTile>

      <ToolTile name="Noise player" href="/tools/noise-player">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M6 10v4"></path>
          <path d="M10 6v12"></path>
          <path d="M14 3v18"></path>
          <path d="M18 8v8"></path>
        </svg>
      </ToolTile>

      <ToolTile name="Currency converter" href="/tools/currency-converter">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M7 10h11l-3-3"></path>
          <path d="M17 14H6l3 3"></path>
        </svg>
      </ToolTile>

      <ToolTile name="PDF editor" href={null} status="planned">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M6 2h8l4 4v16H6z"></path>
          <path d="M14 2v4h4"></path>
          <path d="M9 13h6"></path>
          <path d="M9 16.5h6"></path>
        </svg>
      </ToolTile>

      <ToolTile name="URL shortener" href={null} status="planned">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M9.5 14.5l5-5"></path>
          <path d="M8 16.5a3.5 3.5 0 0 1 0-5l2-2"></path>
          <path d="M16 7.5a3.5 3.5 0 0 1 0 5l-2 2"></path>
        </svg>
      </ToolTile>
    </div>
  </section>
</BaseLayout>
