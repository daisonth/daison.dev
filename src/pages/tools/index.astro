---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Tag from "../../components/ui/Tag.astro";

// Each tool is its own codebase/deploy, linked in from here once it ships.
// `href: null` renders as a disabled, planned entry.
const tools: { name: string; description: string; href: string | null }[] = [
  { name: "PDF editor", description: "Edit PDFs in the browser. No upload, no account.", href: null },
  { name: "URL shortener", description: "Short links, self-hosted, no tracking pixels.", href: null },
];
---

<BaseLayout
  title="Tools"
  description="A small, growing library of free, ad-free, no-nonsense tools."
>
  <section class="py-12 sm:py-16">
    <h1 class="text-2xl font-bold">Tools</h1>
    <p class="mt-4 max-w-md text-ink/70">
      Free, ad-free, no tracking. Each one is its own small, fast thing — built here because I
      needed it myself.
    </p>

    <ul class="mt-10 grid gap-px border border-ink/15 bg-ink/15 sm:grid-cols-2">
      {
        tools.map((tool) => (
          <li class="bg-paper p-6">
            {tool.href ? (
              <a href={tool.href} class="group block">
                <h2 class="font-semibold group-hover:text-red">{tool.name}</h2>
                <p class="mt-1 text-sm text-ink/70">{tool.description}</p>
              </a>
            ) : (
              <div class="opacity-50">
                <div class="flex items-center gap-2">
                  <h2 class="font-semibold">{tool.name}</h2>
                  <Tag>planned</Tag>
                </div>
                <p class="mt-1 text-sm text-ink/70">{tool.description}</p>
              </div>
            )}
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
