---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Tag from "../../components/ui/Tag.astro";
import Button from "../../components/ui/Button.astro";
import { formatDate } from "../../lib/utils";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
---

<BaseLayout title={project.data.title} description={project.data.description}>
  <article class="py-16">
    <a href="/projects" class="text-sm text-ink/50 hover:text-red">&larr; projects</a>

    <h1 class="mt-4 text-2xl font-bold">{project.data.title}</h1>
    <p class="mt-2 font-mono text-xs text-ink/50">{formatDate(project.data.date)}</p>

    <div class="mt-3 flex flex-wrap gap-2">
      <Tag>{project.data.status}</Tag>
      {project.data.tags.map((tag) => <Tag>{tag}</Tag>)}
    </div>

    <div class="prose mt-8">
      <Content />
    </div>

    <div class="mt-10 flex gap-3">
      {project.data.url && (
        <Button href={project.data.url} variant="solid">
          visit
        </Button>
      )}
      {project.data.repo && (
        <Button href={project.data.repo} variant="outline">
          source
        </Button>
      )}
    </div>
  </article>
</BaseLayout>
