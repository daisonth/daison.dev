---
import ThemeToggle from "../ui/ThemeToggle.astro";

// Projects and notes are deliberately left out of the nav until each has
// at least one real entry — no point linking to an empty listing page.
const links = [
  { href: "/", label: "home" },
  { href: "/tools", label: "tools" },
  { href: "/contact", label: "contact" },
];

const path = Astro.url.pathname;
const isActive = (href: string) => (href === "/" ? path === "/" : path.startsWith(href));
---

<header class="relative z-10 border-b border-ink/15">
  <nav
    class="mx-auto flex max-w-4xl flex-wrap items-center justify-between gap-x-4 gap-y-3 px-4 py-5 sm:px-6 sm:py-6"
  >
    <a href="/" class="text-sm font-bold tracking-tight uppercase">daison.dev</a>
    <div class="flex flex-wrap items-center gap-x-4 gap-y-3 sm:gap-x-5">
      <ul class="flex flex-wrap gap-x-4 gap-y-2 text-sm sm:gap-x-5">
        {
          links.map((link) => (
            <li>
              <a
                href={link.href}
                aria-current={isActive(link.href) ? "page" : undefined}
                class="inline-block border-b-2 border-transparent px-0.5 py-1.5 transition-colors hover:border-red aria-[current=page]:border-red"
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
      <ThemeToggle />
    </div>
  </nav>
</header>
