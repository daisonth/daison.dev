---
const links = [
  { href: "/", label: "home" },
  { href: "/projects", label: "projects" },
  { href: "/notes", label: "notes" },
  { href: "/tools", label: "tools" },
  { href: "/contact", label: "contact" },
];

const path = Astro.url.pathname;
const isActive = (href: string) => (href === "/" ? path === "/" : path.startsWith(href));
---

<header class="relative z-10 border-b border-ink/15">
  <nav class="mx-auto flex max-w-4xl items-center justify-between px-6 py-6">
    <a href="/" class="text-sm font-bold tracking-tight uppercase">daison.dev</a>
    <ul class="flex gap-5 text-sm">
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              aria-current={isActive(link.href) ? "page" : undefined}
              class="border-b-2 border-transparent pb-0.5 transition-colors hover:border-red aria-[current=page]:border-red"
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>
